TELEGRAM_BOT_TOKEN=cole_aqui_o_token_do_bot

# Exemplo: https://seudominio.com.br/webservice/v1
IXC_BASE_URL=https://SEU_DOMINIO/webservice/v1
IXC_TOKEN=SEU_TOKEN_IXC
IXC_SELF_SIGNED=true

# Conta web dedicada do IXC, sem 2FA, com permissao para autorizar ONU.
# Necessaria porque o botao "Autorizar ONU" nao faz parte do CRUD da API.

# Atendimento e OS gerados depois da autorizacao da ONU.
IXC_OS_ENABLED=true
IXC_OS_SUBJECT_ID=7
IXC_OS_SECTOR_ID=3
IXC_OS_PROCESS_ID=71
IXC_OS_TASK_ID=677
IXC_OS_RESPONSE_ID=5
IXC_OS_DIAGNOSIS_ID=507
# Colaborador responsavel exibido na finalizacao da OS (367 = Hiago).
IXC_OS_TECHNICIAN_ID=367

# Comece em true para testar o fluxo sem gravar no IXC.
DRY_RUN=true

# Opcional: se preencher, somente esses Telegram IDs usam o bot.
# Exemplo: 123456789,987654321
ALLOWED_TELEGRAM_IDS=
# IDs das OLTs conferidos em Autorizar ONUs > Consultar por OLT.
# Alternativa quando a API nao permite listar radpop_radio; revisar ao adicionar/remover OLT.
IXC_PENDING_OLT_IDS=
