[Unit]
Description=Interface web leve do provisionamento IXC
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/agenda/apps/provisionamento-web/current
EnvironmentFile=/home/agenda/apps/provisionamento-web/.env.web
ExecStart=/home/agenda/.nvm/versions/node/v24.13.0/bin/node src/web.js
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
